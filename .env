# Настройки стека. Файл лежит в git вместе с секретами стенда (репозиторий
# закрыт), чтобы стек поднимался сразу после pull. Значения ниже — стенда.
# На боевом сервере .env свой: замените значения, помеченные «на сервере»,
# уберите строки блока «только стенд» и закройте файл: chmod 600 .env.
# При обновлении из git серверный .env откладывают (docs/release.md).

# Пароль Neo4j (обязателен). На сервере — свой (openssl rand -hex 24).
NEO4J_PASSWORD=password123

# Имя, под которым модель видна через OpenAI-совместимый API vLLM.
# Именно это значение использует сервис api.
VLLM_MODEL=RedHatAI/Qwen3.8-27B-INT4

# Каталог с весами внутри ${MODELS_DIR}. Обычно последний сегмент VLLM_MODEL.
# Задавайте явно: vLLM берёт его отсюда.
VLLM_MODEL_DIR=Qwen3.8-27B-INT4

# Где на хосте лежат веса моделей (внутрь контейнера монтируется как /models).
# Веса кладут сюда отдельно (docker их не скачивает); vLLM читает их без сети.
MODELS_DIR=./models

# Образ vLLM. Скачивается при релизе; тег закреплён явно.
VLLM_IMAGE=vllm/vllm-openai:v0.30.0

# Тег образов API и интерфейса. На сервере — разный у каждого релиза
# (например 1.4.0): тогда образы прежнего остаются и откат не требует сети.
APP_VERSION=latest

# Модель на другом сервере (без GPU здесь): OpenAI-совместимый адрес и ключ.
# VLLM_URL=http://gpu-host:8000/v1
# VLLM_API_KEY=change_me
# Корневой сертификат модели по https://, если он выдан внутренним ЦС:
# положите файл в ./certs рядом с compose. Если не задан, используются системные.
# LLM_CA_FILE=/certs/corp-ca.pem

# Сколько контейнеров локального vLLM запускать: 1 — модель на этом сервере
# (нужен GPU), 0 — сервис vllm не поднимается вовсе, даже ручным
# docker compose up -d (для внешнего VLLM_URL).
# VLLM_REPLICAS=1

# Прокси. Обращения между сервисами (vllm, keycloak, neo4j, api, web,
# localhost) идут мимо прокси из ~/.docker/config.json всегда. Свои адреса,
# которые тоже нельзя пускать через прокси (внешний VLLM_URL, корпоративный
# Keycloak), — через запятую; сеть для релиза — docs/release.md.
# NO_PROXY_EXTRA=.corp.local,10.1.2.3    # имена (с точкой — весь домен) и адреса; подсети не понимаются

# Автоперезапуск зависших vLLM и API (сервис autoheal, docs/deployment.md).
# 0 — не запускать (нельзя давать контейнеру docker.sock; тогда systemd-таймер).
# AUTOHEAL_REPLICAS=1
# AUTOHEAL_INTERVAL=30        # раз во сколько секунд проверять unhealthy
# AUTOHEAL_IMAGE=willfarrell/autoheal:1.2.0

# --- Вход в интерфейс --------------------------------------------------------
# Кто пользователь — решает Keycloak (OpenID Connect): интерфейс входит через
# него и присылает API выданный токен. Роли назначаются в интерфейсе,
# раздел «Пользователи»; логин — preferred_username из токена (для AD это
# логин без домена).

# Публичный адрес Keycloak — тот, по которому в него ходит браузер. Он же
# записан издателем в токенах. На сервере — только https:// корпоративного
# Keycloak: по http:// токены и коды входа идут открытым текстом (допустимо
# только для стенда).
KEYCLOAK_URL=http://localhost:8180

# Realm и клиент интерфейса. Клиент — публичный (без секрета), OpenID Connect,
# Standard flow, PKCE S256; Valid redirect URIs и Web origins — адрес интерфейса.
KEYCLOAK_REALM=goal-checker
KEYCLOAK_CLIENT_ID=goal-checker-web

# Адрес Keycloak для самого API, если он отличается от публичного
# (например, по внутреннему имени). По нему читаются ключи подписи токенов.
# Если не задан, используется KEYCLOAK_URL. На сервере обычно не нужен
# или https://sso-internal.corp.local.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# Корневой сертификат Keycloak, если он выдан внутренним ЦС: положите файл
# в ./certs рядом с compose. Если не задан, используются системные.
# KEYCLOAK_CA_FILE=/certs/corp-ca.pem

# Логины, которые всегда администраторы (через запятую). Нужен хотя бы один:
# иначе первому пользователю некому назначить роль. На сервере — свой логин.
AUTH_ADMIN_LOGINS=admin

# На каком адресе сервера слушает интерфейс (порт 3000, без TLS).
#   127.0.0.1 — TLS-прокси стоит на этом же сервере: тогда к порту 3000 нельзя
#               подключиться в обход прокси;
#   0.0.0.0   — прокси на другой машине (или адрес сетевого интерфейса, который
#               смотрит на прокси); закройте порт 3000 для всех, кроме прокси.
# Если не задан — 0.0.0.0, как в прежних версиях.
WEB_BIND=127.0.0.1

# Адрес или подсеть прокси, на котором завершается TLS: из его X-Forwarded-For
# берётся адрес клиента для журнала аудита и ограничения перебора паролей.
# Прокси на этом же сервере приходит в контейнер не с 127.0.0.1, а с адреса
# шлюза docker-сети стека — укажите её подсеть (docker network inspect
# goal-checker_default, поле Subnet), например 172.18.0.0/16.
# TRUSTED_PROXY=10.0.0.5

# Предел запросов к API с одного адреса у nginx интерфейса: в секунду и
# всплеск сверх него; сверх — 429. Без TRUSTED_PROXY все пользователи за
# прокси или NAT делят один предел — тогда его стоит поднять.
# API_RATE_LIMIT=50
# API_RATE_BURST=200

# --- Только стенд: на сервере эти строки удалить ------------------------------
# Keycloak стенда поднимается из docker-compose.stand.yml (его подключает
# COMPOSE_FILE; в боевую сборку этот файл не входит) с realm-ом из
# keycloak/realm-goal-checker.json: учётка стенда — логин admin, пароль
# stand-Hv5P7EjJ. Консоль Keycloak: http://localhost:8180, логин admin,
# пароль KEYCLOAK_ADMIN_PASSWORD. Консоль и интерфейс стенда слушают только
# 127.0.0.1: пароли стенда лежат в git.
COMPOSE_FILE=docker-compose.yml:docker-compose.stand.yml
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.3
KEYCLOAK_ADMIN_PASSWORD=stand-admin-Hv5P7EjJ
# Swagger: http://localhost:8080/docs (только с самого сервера).
ENABLE_DOCS=1

# --- Необязательные настройки ------------------------------------------------
# Помеченные «в интерфейсе» задают значение по умолчанию: после правки
# в разделе «Настройки» действует сохранённое там.

# Таймаут ответа модели при проверке, секунд.
LLM_TIMEOUT_SECONDS=60
# Повторов запроса к модели при ошибке соединения и ответе 5xx.
LLM_MAX_RETRIES=2
LOG_LEVEL=INFO
# Потоков на один пакет целей; по умолчанию 16.
BULK_MAX_WORKERS=4
# Целей в одном пакетном запросе.
MAX_GOALS_PER_REQUEST=200

# BULK_DEADLINE_SECONDS=520   # пакет отвечает не позже; недосчитанные цели — на ручную проверку с пометкой.
#                             # Умолчание: 600 (proxy_read_timeout) − LLM_TIMEOUT_SECONDS − LLM_CONNECT_TIMEOUT_SECONDS − 15
# CHECK_MAX_PENDING=          # ручных проверок в работе и в ожидании; сверх — 503; пусто — 2 × предел запросов к модели
# ADVICE_MAX_ATTEMPTS=3       # попыток советчика подобрать описание атрибута
# ADVICE_MAX_EXAMPLES=40      # примеров каталога для проверки нового описания
# LLM_MAX_CONCURRENCY=32      # одновременных запросов к модели на весь сервис (в интерфейсе); на карте 24 ГБ — 8
# LLM_INTERACTIVE_RESERVE=4   # из них недоступно пакетной проверке — для ручных (в интерфейсе); на карте 24 ГБ — 2
# CHECK_CACHE_TTL_SECONDS=3600  # сколько помнить ответ на ту же цель; 0 — не помнить (в интерфейсе)
# JOB_DESCRIPTIONS_CACHE_TTL_SECONDS=60  # сколько помнить инструкции подразделения между проверками; 0 — не помнить (в интерфейсе)
# VLLM_MAX_MODEL_LEN=16384    # окно модели в токенах; больше окно — больше памяти GPU на запрос
# VLLM_GPU_MEMORY_UTILIZATION=0.90  # доля памяти GPU для vLLM: веса, остальное — кэш запросов; на карте 24 ГБ — 0.93
# JOB_TEXT_MAX_CHARS=24000    # символов инструкций в одном запросе; должно помещаться в окно
# LLM_JSON_MODE=1             # ответ модели по JSON-схеме; 0 — разбор свободного текста
# CHECK_RATE_PER_MINUTE=600   # целей в минуту на пользователя или ключ доступа; 0 — без ограничения (в интерфейсе)
# GOAL_MAX_CHARS=4000         # предел длины цели в символах, 100–8000 (в интерфейсе)
# PROMPT_EXAMPLES_PER_KIND=2  # примеров «есть» и «нет» на атрибут в промпте (в интерфейсе)
# HISTORY_RETENTION_DAYS=365  # срок хранения истории проверок; 0 — не удалять (в интерфейсе)
# KEYCLOAK_TIMEOUT_SECONDS=5  # таймаут чтения ключей подписи из Keycloak
# LLM_MAX_TOKENS=1024         # потолок длины ответа модели при проверке
# DUTIES_MAX_TOKENS=4096      # потолок длины ответа при выписке обязанностей из инструкции
# DUTIES_TIMEOUT_SECONDS=600  # таймаут одного запроса выписки обязанностей (идёт в фоне)
# PROMPT_EXAMPLE_MAX_CHARS=300  # символов одного примера в промпте
# CHECK_CACHE_MAX_ENTRIES=20000  # предельный размер кэша ответов
# SMART_CACHE_TTL_SECONDS=86400  # сколько помнить оценку SMART той же цели
# SMART_SCORE_RETENTION_DAYS=365  # срок хранения оценок SMART в графе; 0 — хранить всегда
# LLM_CONNECT_TIMEOUT_SECONDS=5  # таймаут соединения с моделью
# LLM_BREAKER_TIMEOUTS=3      # таймаутов модели подряд, после которых она считается зависшей; 0 — выключено
# LLM_BREAKER_SECONDS=60      # на сколько секунд; проверки в это время сразу уходят на ручную
# LLM_BREAKER_BULK_WAIT_SECONDS=300  # сколько пакетная проверка ждёт восстановления модели от начала сбоя
# LLM_QUEUE_TIMEOUT_SECONDS=120  # сколько ручная проверка ждёт места в очереди к модели; 0 — без предела
# API_THREADS=                # потоков обработчиков API; пусто — по ёмкости модели
# DUTIES_WORKERS=1            # одновременных фоновых выписок обязанностей (1 или 2)
# SEED_DATA=0                 # 1 — восстановить каталог из neo4j/init/data.cypher (файл сервера, в git
#                             #     его нет): узлы каталога удаляются и загружаются из файла в одной
#                             #     транзакции; пользователи, ключи, настройки и история не трогаются;
#                             #     нет файла — каталог не трогается
# SEED_REAPPLY=0              # 1 — выполнить уже применённую миграцию (SEED_FILE) ещё раз
# AUDIT_RETENTION_DAYS=365    # сколько суток хранить сменённые файлы журнала аудита (том api_audit), по возрасту
# AUDIT_MAX_TOTAL_MB=20480    # предел объёма всего журнала аудита; сверх — ERROR, анонимные отказы не пишутся
# AUDIT_SYSLOG_URL=tls://siem.corp.local:6514  # журнал аудита в SIEM (syslog RFC 5424): udp://, tcp:// или tls://
# AUDIT_SYSLOG_CA_FILE=/certs/corp-ca.pem      # корень внутреннего ЦС для tls:// (файл в ./certs)
# AUDIT_SYSLOG_HOSTNAME=ALB-PH-UCTLLM1         # имя сервера в строках syslog; по умолчанию — имя контейнера
# LOG_MAX_SIZE=50m            # размер одного файла лога контейнера
# LOG_MAX_FILES=5             # сколько файлов лога хранить на контейнер
