# Настройки резервного копирования для таймеров goal-checker-backup@ и
# goal-checker-dump@: скопируйте в /etc/default/goal-checker-backup.
# Без файла — значения по умолчанию (копии в /opt/goal-checker/backups).

# Куда класть копии и дампы. Лучше — другой диск или сетевой ресурс:
# при отказе диска сервера копии на нём пропадут вместе с базой.
# BACKUP_DIR=/mnt/backup/goal-checker

# Сколько дней хранить ночные копии auto-*.
# BACKUP_KEEP_DAYS=14

# Сколько дней хранить дампы dump-* (еженедельные и снятые перед релизом).
# DUMP_KEEP_DAYS=60
