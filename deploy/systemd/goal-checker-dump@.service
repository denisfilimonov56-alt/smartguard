# Полный дамп базы с проверкой: scripts/dump.sh (docs/deployment.md, «Регламент
# резервного копирования»). API и Neo4j останавливаются примерно на минуту.
# Экземпляр — пользователь с правом на docker: goal-checker-dump@deploy.timer.
[Unit]
Description=goal-checker: еженедельный дамп базы с проверкой
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=%i
WorkingDirectory=/opt/goal-checker
# BACKUP_DIR, DUMP_KEEP_DAYS — см. goal-checker-backup.env.example
EnvironmentFile=-/etc/default/goal-checker-backup
ExecStart=/opt/goal-checker/scripts/dump.sh
# Дамп с проверкой большой базы идёт дольше стандартных 90 секунд.
TimeoutStartSec=2h
