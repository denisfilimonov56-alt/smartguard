# Интерфейс и API на одном origin: статика из образа, /api — в сервис api.
# Благодаря этому CORS между интерфейсом и API не нужен вовсе, а порт API
# наружу не публикуется. В Keycloak браузер ходит напрямую — у него свой CORS
# (Web origins клиента).
#
# Файл — шаблон: при старте контейнера nginx подставляет ${TRUSTED_PROXY},
# ${API_RATE_LIMIT} и ${API_RATE_BURST} (см. /docker-entrypoint.d/20-envsubst-on-templates.sh
# в образе nginx; умолчания и проверка чисел — в 15-api-rate.envsh).
# Заголовки безопасности и CSP с адресом Keycloak — в security-headers.inc.

# TLS завершается на внешнем прокси. Его адрес (или подсеть) — в TRUSTED_PROXY:
# тогда настоящий адрес клиента берётся из X-Forwarded-For этого прокси и
# попадает в журнал аудита и в ограничение перебора паролей. От остальных
# источников заголовок не принимается — подделать адрес им нельзя.
set_real_ip_from ${TRUSTED_PROXY};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Частота запросов к API с одного адреса (после real_ip — настоящего клиента).
# Интерфейс шлёт пакет частями по очереди, а при загрузке страницы — десяток
# запросов разом: это укладывается в burst. Внешней системе хватает с запасом
# на лимит проверок (checkRatePerMinute) — его считает сам API. Сверх — 429:
# поток запросов без входа не забивает журнал аудита и потоки API.
# Умолчание (50 в секунду, всплеск 200) рассчитано и на офис за NAT, когда
# TRUSTED_PROXY не настроен и все делят один адрес; меняется через
# API_RATE_LIMIT и API_RATE_BURST.
limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=${API_RATE_LIMIT}r/s;

server {
    listen 80;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    include /etc/nginx/conf.d/security-headers.inc;

    # Сжатие: бандл и JSON API заметно меньше. Ответы меньше килобайта не
    # сжимаются — выигрыша нет.
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;

    # index.html — всегда перепроверять: после обновления браузер должен сразу
    # получить ссылки на новые бандлы, а не держать старую страницу из
    # эвристического кэша. Сюда же приходит SPA-фолбэк из location /.
    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
    }

    # Бандлы с хэшем в имени не меняются никогда: кэш на год. Отсутствующий
    # файл — честный 404, а не index.html: иначе старая страница получает
    # HTML вместо модуля и показывает белый экран.
    location /assets/ {
        try_files $uri =404;
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri /index.html;
    }

    # Служебные маршруты API — только с самого сервера (localhost:8080).
    location ~ ^/api/(ready|metrics|docs|openapi\.json)/?$ {
        return 404;
    }

    location /api/ {
        limit_req zone=api_per_ip burst=${API_RATE_BURST} nodelay;
        limit_req_status 429;
        limit_req_log_level warn;

        # Имя сервиса разрешается при каждом запросе, а не один раз на старте:
        # пересозданный контейнер api получает новый адрес.
        resolver 127.0.0.11 valid=10s;
        set $api http://api:8080;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        # Идентификатор запроса для журнала аудита: всегда свой, пришедший от клиента не принимается.
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Пакетная проверка целей ждёт модель минутами. Интерфейс ждёт ответа
        # чуть дольше (610 с), чтобы первым сработал этот таймаут, а не его.
        # Внешний TLS-прокси перед портом 3000 должен ждать не меньше.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        client_max_body_size 2m;
    }
}
