#!/bin/sh
# Предел частоты запросов к /api/ с одного адреса для шаблона nginx:
# API_RATE_LIMIT — запросов в секунду (по умолчанию 50), API_RATE_BURST —
# всплеск сверх него (по умолчанию 200). Значения подставляются в limit_req
# как есть, поэтому принимаются только целые числа больше нуля: опечатка в .env
# не должна валить nginx при старте — вместо неё берётся умолчание с
# предупреждением в журнал контейнера.
#
# Файл подключается точкой из /docker-entrypoint.sh до 20-envsubst-on-templates.sh,
# поэтому экспортированные переменные попадают в шаблоны nginx.

_rate_value() {
  # $1 — имя переменной, $2 — её значение, $3 — умолчание.
  case "$2" in
    "") printf '%s' "$3" ;;
    *[!0-9]*|0*)
      echo "$0: $1=$2 — не целое число больше нуля, используется $3" >&2
      printf '%s' "$3" ;;
    *) printf '%s' "$2" ;;
  esac
}

API_RATE_LIMIT="$(_rate_value API_RATE_LIMIT "${API_RATE_LIMIT:-}" 50)"
API_RATE_BURST="$(_rate_value API_RATE_BURST "${API_RATE_BURST:-}" 200)"
export API_RATE_LIMIT API_RATE_BURST
unset -f _rate_value
